{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TradingAgents",
  "version": "1.0.0",
  "identifier": "com.tradingagents.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "TradingAgents",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Finance",
    "shortDescription": "Multi-agent A-share trading research workbench",
    "longDescription": "TradingAgents bundles the LangGraph multi-agent research backend and the React workbench into a single desktop application.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/tradingagents-backend"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
