# Vite env for the Tauri desktop build (loaded via `vite build --mode tauri`).
#
# The packaged frontend is served from Tauri's custom protocol, so it cannot
# use relative `/api` URLs or `window.location.host`. These point the REST and
# WebSocket clients at the bundled backend sidecar, which binds 127.0.0.1:8422
# (see src-tauri/src/main.rs). Regular `npm run build` (web) ignores this file
# and keeps same-origin/relative behavior.
VITE_API_BASE_URL=http://127.0.0.1:8422
VITE_WS_BASE_URL=ws://127.0.0.1:8422
